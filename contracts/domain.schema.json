{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "联合考古上下文版本库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "TERM_REGISTERED",
        "CANDIDATE_PROPOSED",
        "BILATERAL_REVIEWED",
        "PASSAGE_REGISTERED",
        "PASSAGE_STATE_CHANGED",
        "PASSAGE_MIGRATED",
        "ERRATA_ISSUED",
        "REVISION_PREPARED",
        "REVISION_SIGNED",
        "REVISION_APPLIED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "source_term",
        "translation_candidate",
        "narrative_passage",
        "errata_release",
        "term_revision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
